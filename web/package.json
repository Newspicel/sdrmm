{
  "name": "sdrmm-web",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.8.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "record:resolved": "node scripts/record-resolved.mjs",
    "e2e": "playwright test",
    "demo:record": "playwright test -c playwright.demo.config.ts",
    "lint": "node scripts/check-base-ui.mjs && node scripts/check-design-tokens.mjs && oxlint --type-aware",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.16.0",
    "openapi-fetch": "0.17.0",
    "opus-decoder": "0.7.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swagger-ui-dist": "5.34.0",
    "uqr": "^0.1.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
